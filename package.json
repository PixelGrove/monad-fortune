{
  "name": "monad-quick-fortune",
  "version": "1.0.0",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "monad-quick-fortune": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "nodemon --exec 'npm run build && npm start' --watch src",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "monad",
    "mcp",
    "blockchain"
  ],
  "author": "",
  "license": "ISC",
  "description": "MCP server for Monad Testnet interaction",
  "dependencies": {
    "dotenv": "^16.5.0",
    "ethers": "^6.13.7",
    "viem": "^2.7.8",
    "zod": "^3.22.4",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "typescript": "^5.4.2",
    "@types/node": "^20.11.28",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1"
  },
  "files": [
    "build",
    "src",
    "package.json",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
